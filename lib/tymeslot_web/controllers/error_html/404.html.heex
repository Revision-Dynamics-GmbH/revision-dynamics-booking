<%!--
  Revision Dynamics (rd-mail-brand.patch): the page-not-found page in the
  website's look (`TymeslotWeb.Components.RdPage`). Self-contained on purpose:
  this template renders with no layout (the endpoint's `render_errors` sets
  `layout: false`, and the catch-all FallbackController disables both
  layouts). No canonical `<link>`: a 404 must not advertise the missing URL as
  its own canonical. Every link leads to revisiondynamics.com, where the
  booking lives.
--%>
<TymeslotWeb.Components.RdPage.page
  lang={Gettext.get_locale(TymeslotWeb.Gettext)}
  page_title={dgettext("errors", "Page not found")}
  eyebrow={dgettext("errors", "Error 404")}
  title={dgettext("errors", "This page does not exist.")}
  text={
    dgettext(
      "errors",
      "The link may be incomplete or out of date. You can book an appointment on our website."
    )
  }
  action_label={dgettext("errors", "Book an appointment")}
  action_href={"https://revisiondynamics.com/#{TymeslotWeb.Components.RdPage.site_locale(Gettext.get_locale(TymeslotWeb.Gettext))}/termin"}
  secondary_label={dgettext("errors", "Contact")}
  secondary_href={"https://revisiondynamics.com/#{TymeslotWeb.Components.RdPage.site_locale(Gettext.get_locale(TymeslotWeb.Gettext))}/contact"}
/>
